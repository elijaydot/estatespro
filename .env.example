# Supabase Project Configuration
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_PROJECT_ID="your-project-id"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-key"
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Rwanda Development Board (RDB) KYB & NIDA Identity Verification
# Conduit KYB (https://docs.conduit.financial/kyb/countries/rwanda)
VITE_CONDUIT_API_KEY="your-conduit-api-key"
# AiPrise Rwanda KYB (https://docs.aiprise.com/docs/kyb-rwanda)
VITE_AIPRISE_API_KEY="your-aiprise-api-key"
# Smile ID / Dojah Rwanda KYC (NIDA 16-Digit Identity Verification)
VITE_SMILE_ID_API_KEY="your-smile-id-api-key"

# Rwanda Revenue Authority (RRA) EBM v2 & VSDC
VITE_RRA_COMPANY_TIN="100234567"
VITE_RRA_SDC_ID="VSDC-RRA-RW001"
VITE_RRA_MRC="RRA-FISHGATE-01"
VITE_RRA_VSDC_URL="https://ebm.rra.gov.rw:8443/vsdc/api"

# Paypack Rwanda (MTN MoMo *182# & Airtel Money *175# Payment Gateway)
VITE_PAYPACK_CLIENT_ID="your-paypack-client-id"
VITE_PAYPACK_CLIENT_SECRET="your-paypack-client-secret"
VITE_PAYPACK_ENVIRONMENT="sandbox"

# MTN MoMo OpenAPI Direct (Optional)
VITE_MTN_MOMO_PRIMARY_KEY="your-momo-primary-key"
VITE_MTN_MOMO_USER_ID="your-momo-user-id"
VITE_MTN_MOMO_API_KEY="your-momo-api-key"
VITE_MTN_MOMO_ENVIRONMENT="sandbox"

# East Africa & Global SMS Gateways
# Primary: Africa's Talking (Rwanda MTN/Airtel, Kenya Safaricom M-Pesa, Uganda MTN)
VITE_AFRICAS_TALKING_USERNAME="sandbox"
VITE_AFRICAS_TALKING_API_KEY="your-africas-talking-api-key"
VITE_AFRICAS_TALKING_SENDER_ID="FishGate"

# Backup / International Failover: Twilio
VITE_TWILIO_ACCOUNT_SID="your-twilio-account-sid"
VITE_TWILIO_AUTH_TOKEN="your-twilio-auth-token"
VITE_TWILIO_PHONE_NUMBER="+1234567890"
