      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/marketplace-public?mode=detail&id_or_slug={{listingIdOrSlug}}",
          "host": ["{{baseUrl}}"],
          "path": ["marketplace-public"],
          "query": [
            { "key": "mode", "value": "detail" },
            { "key": "id_or_slug", "value": "{{listingIdOrSlug}}" }
          ]
        }
      },
      "response": []
    },
    {
