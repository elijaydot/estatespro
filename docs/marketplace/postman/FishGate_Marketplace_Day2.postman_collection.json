    "description": "Smoke tests for marketplace-public and marketplace-inquiry edge functions"
  },
  "item": [
    {
      "name": "Public Listings - List",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/marketplace-public?mode=list&page=1&page_size=5",
          "host": ["{{baseUrl}}"],
          "path": ["marketplace-public"],
          "query": [
            { "key": "mode", "value": "list" },
            { "key": "page", "value": "1" },
            { "key": "page_size", "value": "5" }
          ]
        }
      },
      "response": []
    },
    {
