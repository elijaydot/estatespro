        "body": {
          "mode": "raw",
          "raw": "{\n  \"listing_id\": \"{{listingId}}\",\n  \"full_name\": \"Test Prospect\",\n  \"phone_e164\": \"+2348000000000\",\n  \"email\": \"test@example.com\",\n  \"message\": \"Interested in this listing\",\n  \"budget_min\": 1500000,\n  \"budget_max\": 3000000,\n  \"consent_marketing\": false\n}"
